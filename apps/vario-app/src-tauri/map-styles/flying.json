{
 "version": 8,
 "name": "Flug",
 "metadata": {
  "about": "Flying map for the Vario app, derived from the outdoor_app's topo-summer.json (strong terrain, peaks, few details, obstacles stand out). Edited by hand.",
  "placeholders": {
   "__TILES__": "base URL of the tile protocol",
   "__FONTS__": "base URL of the glyph files",
   "__CONTOURS__": "tile URL of the contour line generator"
  }
 },
 "glyphs": "__FONTS__{fontstack}/{range}.pbf",
 "sources": {
  "basemap": {
   "type": "vector",
   "tiles": [
    "__TILES__basemap/{z}/{x}/{y}"
   ],
   "minzoom": 0,
   "maxzoom": 14
  },
  "outdoor": {
   "type": "vector",
   "tiles": [
    "__TILES__outdoor/{z}/{x}/{y}"
   ],
   "minzoom": 7,
   "maxzoom": 14
  },
  "dem": {
   "type": "raster-dem",
   "tiles": [
    "__TILES__dem/{z}/{x}/{y}"
   ],
   "encoding": "terrarium",
   "tileSize": 512,
   "minzoom": 0,
   "maxzoom": 13
  },
  "contours": {
   "type": "vector",
   "tiles": [
    "__CONTOURS__"
   ],
   "maxzoom": 15
  }
